     TaskList,
     TaskItem.configure({ nested: true }),
     Link.configure({ openOnClick: false }),
-    Image,
+    options.resolveImageSrc ? createResolvedImage(options.resolveImageSrc) : Image,
     HtmlBlock.configure({ sanitize: options.sanitizeEmbeddedHtml }),
